  "cards": [
    {
      "dot": "cyan",
      "title": "Every observation is evidence-backed",
      "items": [
        "source_id + locator (BT term or page) + verbatim German quote",
        "Scope is PROCEDURE or one LOT, never mixed",
        "LLM claims survive only if the quote is a substring of the chunk",
        "Unknown is a state: KNOWN · NOT_FOUND · REFERRED_TO_DOCUMENTS · CONFLICTING"
      ]
    },
    {
      "dot": "violet",
      "title": "Resolution is a read-time view (ADR 0001)",
      "items": [
        "Rows are never updated; a superseded notice version drops out of the view",
        "Precedence: structured field > rule > model over document > model over notice",
        "Equal-precedence disagreement → CONFLICTING, no current value",
        "Confidence derives from the extractor; corroboration is a signal line"
      ]
    },
    {
      "dot": "amber",
      "title": "Triggers and v1 limits",
      "items": [
        "ingest_job table is the queue; one worker drains it, the web polls the stepper",
        "Plain HTTP only: gated platforms stay REFERRED_TO_DOCUMENTS with the platform named",
        "PDF text layer only: no OCR, DOCX/XLSX, CSV/OCDS are P2",
        "Estimated value is NOT_FOUND unless the notice states it"
      ]
    }
  ]
