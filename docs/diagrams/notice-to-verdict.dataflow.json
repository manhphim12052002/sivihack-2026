      "to": "tasks",
      "label": "constraints",
      "classification": "typed limits",
      "variant": "emphasis",
      "labelDy": 66
    },
    {
      "id": "routed-tasks",
      "from": "tasks",
      "to": "matchers",
      "label": "routed by kind",
      "classification": "hard / soft",
      "variant": "emphasis",
      "labelDy": 24
    },
    {
      "id": "criterion-lines",
      "from": "matchers",
      "to": "verdict",
      "label": "criterion lines",
      "classification": "quote vs fact",
      "variant": "emphasis",
      "labelDy": 24
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "The claim the pipeline earns",
      "items": [
        "A verdict line pairs a German clause, its document and page, with the company fact it met",
        "The model types and quotes; precedence and every comparison are code",
        "A fact with no reading stays Unknown; nothing is inferred to fill a hole"
      ]
    },
    {
      "dot": "violet",
      "title": "Resolved at read time",
      "items": [
        "Rows are inserted, never updated, so a superseded notice version drops out of the view",
        "Precedence: structured field, rule, model over document, model over notice",
        "Equal-precedence disagreement resolves to CONFLICTING, not a silent winner"
      ]
    },
    {
      "dot": "amber",
      "title": "Honest limits",
      "items": [
        "PDF text layer only: no OCR, and DOCX/XLSX are not routed yet",
        "A portal that demands a form is recorded GATED with its host named",
        "Only filename-routed conditions documents are read, not drawings or bills"
      ]
    }
  ]
}
