{
  "schema_version": 1,
  "diagram_type": "dataflow",
  "meta": {
    "title": "Notice to Verdict",
    "locale": "en",
    "quality_profile": "showcase",
    "viewBox": [
      1080,
      500
    ],
    "views": [
      {
        "id": "document-path",
        "label": "Into the documents",
        "focus": [
          "package",
          "doc_reader",
          "gate",
          "observations"
        ],
        "note": "The disqualifying clause sits in an attachment, so the package is read, not just the notice."
      },
      {
        "id": "resolution",
        "label": "Read-time resolution",
        "focus": [
          "observations",
          "resolved",
          "tasks"
        ],
        "note": "Nothing is overwritten: precedence and agreement pick the value when it is read."
      },
      {
        "id": "company-path",
        "label": "Company lane",
        "focus": [
          "company_doc",
          "company_extract",
          "canonical",
          "tasks"
        ],
        "note": "The profile is extracted the same way and carries its own evidence."
      }
    ],
    "legend": {
      "mode": "auto",
      "entries": {
        "security": {
          "label": "evidence gate"
        },
        "emphasis": {
          "label": "tender evidence"
        },
        "default": {
          "label": "company data"
        }
      }
    }
  },
  "stages": [
    {
      "label": "Sources"
    },
    {
      "label": "Extraction"
    },
    {
      "label": "Evidence"
    },
    {
      "label": "Store and resolve"
    },
    {
      "label": "Decision"
    }
  ],
  "nodes": [
