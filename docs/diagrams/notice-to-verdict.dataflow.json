      "tag": "German"
    },
    {
      "id": "package",
      "type": "external",
      "label": "Vergabeunterlagen",
      "sublabel": "ZIP over plain HTTP",
      "stage": 0,
      "row": 1,
      "tag": "German"
    },
    {
      "id": "company_doc",
      "type": "external",
      "label": "Company document",
      "sublabel": "pasted text or PDF",
      "stage": 0,
      "row": 2
