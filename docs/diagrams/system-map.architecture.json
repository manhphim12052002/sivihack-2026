  "cards": [
    {
      "dot": "cyan",
      "title": "One decision, two engines",
      "items": [
        "POST /api/match routes one task per requirement to a rule, ontology, semantic or reference matcher",
        "POST /api/screen runs the deterministic board rules over the demo board relations",
        "No score anywhere: each criterion returns PASS, FAIL or UNCERTAIN with a reason"
      ]
    },
    {
      "dot": "violet",
      "title": "Evidence is the contract",
      "items": [
        "Observations are insert-only; the shown value is chosen at read time by precedence and agreement",
        "A model item survives only if its quote is on the page it cites",
        "Unknown is a state: NOT_FOUND, REFERRED_TO_DOCUMENTS or CONFLICTING"
      ]
    },
    {
      "dot": "amber",
      "title": "Runs on the tech-checked laptop",
      "items": [
        "DATA_BACKEND=json is the default: JSON files, no services, no keys",
        "DATA_BACKEND=supabase serves the same schema; CI applies the migrations",
        "/api/ingest and /api/jobs are still stubs; tenders arrive through the pipeline CLI"
      ]
    }
  ]
