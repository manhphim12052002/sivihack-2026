  "cards": [
    {
      "dot": "emerald",
      "title": "Server-side by construction",
      "items": [
        "The client posts a company id and renders what comes back; it ranks nothing",
        "A different company id re-runs the same code and yields a different shortlist",
        "No score crosses the wire, only criterion lines with a status and a reason"
      ]
    },
    {
      "dot": "rose",
      "title": "What the model is asked",
      "items": [
        "Region, size, guarantee, window and self-performance are decided by rule matchers",
        "Only capability wording and reference comparability go to the model",
        "A model failure degrades that task to UNCERTAIN, never to a pass"
      ]
    },
    {
      "dot": "orange",
      "title": "Two paths, one port",
      "items": [
        "The board path reads the demo board; the briefing path reads the resolved views",
        "Both go through lib/db, so the json backend serves the whole trace offline",
        "Evaluations and results are written back, so a briefing reopens without re-running"
      ]
    }
  ]
}
